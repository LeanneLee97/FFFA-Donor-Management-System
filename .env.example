# Local development needs none of these: the app uses an embedded Postgres (PGlite)
# in .data/pglite, signs you in as a dev admin, and uses draft templates instead of AI.

# Gemini API key for AI-drafted follow-ups (DM10). Without it, drafts use templates.
GEMINI_API_KEY=
# Optional model override. Default: gemini-3.6-flash
GEMINI_MODEL=

# Production database (Supabase Postgres connection string). Unset = local PGlite.
DATABASE_URL=

# dev = auto sign-in as a dev admin (local only). supabase = real login (default in production).
AUTH_MODE=dev

PORT=3000
